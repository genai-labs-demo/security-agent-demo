# AWS Infrastructure Configuration
# Update these values after deploying the CDK stack

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (RDS PostgreSQL)
# Get from CDK output: DatabaseEndpoint
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=vulnerabledemodb
DB_USER=dbadmin
# Get from Secrets Manager: vulnerable-demo-db-credentials
DB_PASSWORD=your-database-password

# AWS Cognito Configuration
# Get from CDK outputs: UserPoolId and UserPoolClientId
USER_POOL_ID=us-east-1_XXXXXXXXX
USER_POOL_CLIENT_ID=your-client-id
AWS_REGION=us-east-1

# CORS Configuration
# Update with your CloudFront domain after deployment
CORS_ORIGINS=https://your-cloudfront-domain.cloudfront.net
