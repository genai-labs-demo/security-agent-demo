{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API with intentional vulnerabilities for AWS Security Agent demo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:seed": "ts-node src/db/seed.ts",
    "db:setup": "ts-node src/db/setup.ts",
    "deploy": "./deploy.sh",
    "docker:build": "docker build -t vulnerable-demo-backend .",
    "docker:run": "docker run -p 3000:3000 --env-file .env vulnerable-demo-backend"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.400.0",
    "@aws-sdk/client-secrets-manager": "^3.400.0",
    "aws-jwt-verify": "^4.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "fast-check": "^3.13.0",
    "pg": "^8.11.0"
  }
}
